# Logs, history, sessions, and cookies
*.log
*history*
*Session*
*Cookies*
*cookie*
*.out
*.err

# Databases and temporary files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.tmp
*.temp
*.bak
*.swp
*~

# Credentials, keys, and certificates
*.key
*.pem
*.crt
*.pfx
*.p12
*id_rsa*
*id_ecdsa*
*id_ed25519*
*.env
*.passwd
*.shadow
*secret*
*credential*
*token*
*passwords*
*.gpg
*.asc

# Python and compilation artifacts
__pycache__/
*.pyc
*.pyo
*.pyd

# Node.js and dependencies
node_modules/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Shell variables and local state
fish_variables*
private.fish

# Locks and sockets
*.lock
*.sock
*.pid

# Local tooling and runtime artifacts
.ruff_cache/

# Local Nix state and development image archives
.devenv/
.direnv/
.devenv.*
.devenv.flake.nix
devenv.local.*
!devenv.lock

# Shared VS Code configuration; keep personal editor state ignored.
!/.vscode/
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/*.code-snippets
!/.vscode/README.md
